  -- test helpers (temporary, gone with the rollback)
  create temp table q_chk (i serial, name text, ok boolean, got text) on commit drop;
  create or replace function pg_temp.q_ck(p_name text, p_ok boolean, p_got text) returns void language sql as $q$
    insert into pg_temp.q_chk (name, ok, got) values (p_name, coalesce(p_ok, false), p_got) $q$;
  -- "signed in as": the JWT claims PostgREST sets, and the role the app's requests run as (authenticated)
  create or replace function pg_temp.q_as(p_uid uuid) returns void language plpgsql as $q$
  begin
    perform set_config('request.jwt.claim.sub', '', true);
    if p_uid is null then perform set_config('request.jwt.claims', '{"role":"anon"}', true); return; end if;
    perform set_config('request.jwt.claims', jsonb_build_object('sub', p_uid, 'role', 'authenticated', 'aal', 'aal1')::text, true);
    if current_setting('pbrec.as_auth', true) = '1' then set local role authenticated; end if;
  end $q$;
