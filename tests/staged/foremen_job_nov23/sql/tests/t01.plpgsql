-- foremen_job_nov23 test 01: "Foremen on this job". Every app call runs AS ROLE authenticated with that person's JWT
-- claims (pg_temp.fq), the way PostgREST runs it, so a function authenticated can't execute fails here too.
-- Always ends with ERROR 'RESULT: n pass, m fail ...' so everything (the apply above it and the throwaway people) rolls back.
create function pg_temp.fq(p_user uuid, p_sql text) returns jsonb language plpgsql as $f$
declare r jsonb;
begin
  begin
    perform set_config('request.jwt.claims', jsonb_build_object('role', 'authenticated', 'sub', p_user, 'aal', 'aal1')::text, true);
    perform set_config('role', 'authenticated', true);
    execute p_sql into r;
    perform set_config('role', 'none', true);
    return coalesce(r, 'null'::jsonb);
  exception when others then
    return jsonb_build_object('err', sqlerrm);   -- (the role switch is undone with the failed sub-transaction)
  end;
end $f$;
create function pg_temp.fanon(p_sql text) returns jsonb language plpgsql as $f$
declare r jsonb;
begin
  begin
    perform set_config('request.jwt.claims', '{"role": "anon"}', true);
    perform set_config('role', 'anon', true);
    execute p_sql into r;
    perform set_config('role', 'none', true);
    return coalesce(r, 'null'::jsonb);
  exception when others then return jsonb_build_object('err', sqlerrm);
  end;
end $f$;
create function pg_temp.fe(j jsonb) returns text language sql as $f$ select coalesce(j->>'err', j->>'code', case when (j->>'ok')::boolean then 'ok' else j::text end) $f$;
create function pg_temp.fids(j jsonb) returns text language sql as $f$ select coalesce(string_agg(e->>'user_id', ',' order by e->>'user_id'), '') from jsonb_array_elements(coalesce(j->'assigned', '[]')) e $f$;
create function pg_temp.fset(p_user uuid, p_job text, p_ids uuid[], p_ver integer) returns jsonb language sql as $f$
  select pg_temp.fq(p_user, format('select public.pb_job_foremen_set(%L, %L::uuid[], %L, %s)', p_job, p_ids, p_user, p_ver)) $f$;
create function pg_temp.fget(p_user uuid, p_job text) returns jsonb language sql as $f$
  select pg_temp.fq(p_user, format('select public.pb_job_foremen_get(%L)', p_job)) $f$;

do $test$
declare
  pass integer; fail integer; fails text; notes text := ''; tag text := substr(md5(random()::text), 1, 8);
  o uuid := gen_random_uuid(); pm uuid := gen_random_uuid(); mgr uuid := gen_random_uuid(); f1 uuid := gen_random_uuid(); f2 uuid := gen_random_uuid();
  f3 uuid := gen_random_uuid(); p1 uuid := gen_random_uuid(); o2 uuid := gen_random_uuid(); x uuid := gen_random_uuid();
  c uuid := gen_random_uuid(); c2 uuid := gen_random_uuid(); c3 uuid := gen_random_uuid(); o3 uuid := gen_random_uuid();
  job text := 'FMJ-' || tag; j jsonb; s text; n integer; v integer; ids text; many uuid[];
  srt text;
begin
  create temp table t_chk (i serial, name text, ok boolean, got text) on commit drop;
  insert into auth.users (id, email) select u, 'pbfmj-' || tag || '-' || row_number() over () || '@example.invalid' from unnest(array[o, pm, mgr, f1, f2, f3, p1, o2, x, o3]) u;
  insert into public.companies (id, name, owner_user_id, status, plan) values (c, 'pbfmj ' || tag, o, 'active', 'paid'), (c2, 'pbfmj other ' || tag, o2, 'active', 'paid'),
    (c3, 'pbfmj lapsed ' || tag, o3, 'canceled', 'paid');
  insert into public.company_members (company_id, user_id, role, title) values (c, pm, 'pm', 'superintendent');
  insert into public.company_members (company_id, user_id, role) values (c, mgr, 'foreman'), (c, f1, 'foreman'), (c, f2, 'foreman'), (c, f3, 'foreman'), (c, p1, 'pipelayer'), (c2, x, 'foreman');
  insert into pb_reports.managers (company_id, user_id) values (c, mgr) on conflict do nothing;   -- a listed manager who is not a PM
  insert into pb_crew.own_names (user_id, name) values (f1, 'Dale Foreman ' || tag) on conflict (user_id) do update set name = excluded.name;

  -- ---- privileges (static) ----
  insert into t_chk (name, ok, got) values ('1a the two app functions: authenticated may execute, anon and PUBLIC may not',
    has_function_privilege('authenticated', 'public.pb_job_foremen_get(text)', 'execute') and has_function_privilege('authenticated', 'public.pb_job_foremen_set(text,uuid[],uuid,integer)', 'execute')
    and not has_function_privilege('anon', 'public.pb_job_foremen_get(text)', 'execute') and not has_function_privilege('anon', 'public.pb_job_foremen_set(text,uuid[],uuid,integer)', 'execute')
    and not exists (select 1 from pg_proc p, aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) a where p.oid in ('public.pb_job_foremen_get(text)'::regprocedure, 'public.pb_job_foremen_set(text,uuid[],uuid,integer)'::regprocedure) and a.grantee = 0), '');
  select count(*) into n from unnest(array['pb_pm.company_foremen(uuid)', 'pb_pm.job_foremen_state(uuid,text)', 'pb_pm.job_foremen_ver(uuid,text)', 'pb_pm.foreman_role_sync()']) f
   where has_function_privilege('authenticated', f::regprocedure, 'execute') or has_function_privilege('anon', f::regprocedure, 'execute');
  insert into t_chk (name, ok, got) values ('1b the private helpers are not callable by authenticated or anon', n = 0, n::text);
  select count(*) into n from pg_proc p where p.oid in ('public.pb_job_foremen_get(text)'::regprocedure, 'public.pb_job_foremen_set(text,uuid[],uuid,integer)'::regprocedure,
     'pb_pm.company_foremen(uuid)'::regprocedure, 'pb_pm.job_foremen_state(uuid,text)'::regprocedure, 'pb_pm.job_foremen_ver(uuid,text)'::regprocedure, 'pb_pm.foreman_role_sync()'::regprocedure)
   and p.prosecdef and exists (select 1 from unnest(p.proconfig) g where g = 'search_path=""');
  insert into t_chk (name, ok, got) values ('1c all six are SECURITY DEFINER with search_path pinned to empty', n = 6, n::text);
  insert into t_chk (name, ok, got) values ('1d pb_pm.job_foremen: row security on, no policy, no table grant to anon/authenticated, schema pb_pm closed to the API',
    (select relrowsecurity from pg_class where oid = 'pb_pm.job_foremen'::regclass) and not exists (select 1 from pg_policy where polrelid = 'pb_pm.job_foremen'::regclass)
    and not has_table_privilege('authenticated', 'pb_pm.job_foremen', 'select') and not has_table_privilege('anon', 'pb_pm.job_foremen', 'select')
    and not has_table_privilege('authenticated', 'pb_pm.job_foremen', 'insert') and not has_schema_privilege('authenticated', 'pb_pm', 'usage') and not has_schema_privilege('anon', 'pb_pm', 'usage'), '');
  -- the permission lesson: every function a policy on the tables we touch calls must be executable by authenticated
  select count(*) into n from pg_policy pol join pg_depend d on d.classid = 'pg_policy'::regclass and d.objid = pol.oid and d.refclassid = 'pg_proc'::regclass
   where pol.polrelid in ('public.companies'::regclass, 'public.company_members'::regclass, 'pb_pm.job_foremen'::regclass, 'pb_pm.audit'::regclass)
     and not has_function_privilege('authenticated', d.refobjid, 'execute');
  insert into t_chk (name, ok, got) values ('1e every function called by a policy on companies / company_members / job_foremen / audit is executable by authenticated', n = 0, n::text);
  insert into t_chk (name, ok, got) values ('1f trigger company_members_foreman_sync is on company_members; the PM trigger is still there',
    exists (select 1 from pg_trigger where tgrelid = 'public.company_members'::regclass and tgname = 'company_members_foreman_sync' and not tgisinternal)
    and exists (select 1 from pg_trigger where tgrelid = 'public.company_members'::regclass and tgname = 'company_members_pm_sync' and not tgisinternal), '');

  -- ---- read the list ----
  j := pg_temp.fget(o, job);
  select string_agg(e->>'user_id', ',' order by e->>'user_id') into ids from jsonb_array_elements(j->'candidates') e;
  select string_agg(u::text, ',' order by u::text) into srt from unnest(array[mgr, f1, f2, f3]) u;
  insert into t_chk (name, ok, got) values ('2a company account reads it: none assigned, version 0, may take people off; the pick list is the company''s 4 foremen (not the PM, the pipelayer or another company''s foreman)',
    pg_temp.fe(j) = 'ok' and jsonb_array_length(j->'assigned') = 0 and (j->>'ver')::int = 0 and (j->>'may_remove')::boolean and (j->>'is_owner')::boolean and ids = srt
    and exists (select 1 from jsonb_array_elements(j->'candidates') e where e->>'user_id' = f1::text and e->>'name' = 'Dale Foreman ' || tag and e->>'email' like 'pbfmj-%'), left(j::text, 300));
  s := pg_temp.fe(pg_temp.fget(f1, job)) || '/' || pg_temp.fe(pg_temp.fget(p1, job)) || '/' || pg_temp.fe(pg_temp.fget(o3, job)) || '/' || pg_temp.fe(pg_temp.fget(o, '   '));
  insert into t_chk (name, ok, got) values ('2b a plain foreman, a pipelayer and the account of a lapsed company cannot read it; a blank job is refused',
    s = 'pb:not_company_account/pb:not_company_account/pb:not_company_account/pb:bad_job', s);
  s := pg_temp.fe(pg_temp.fanon(format('select public.pb_job_foremen_get(%L)', job))) || '/' || pg_temp.fe(pg_temp.fanon(format('select public.pb_job_foremen_set(%L, %L::uuid[], %L, 0)', job, array[f1], o)));
  insert into t_chk (name, ok, got) values ('2c signed out (anon): permission denied for both', s like 'permission denied for function pb_job_foremen_get/permission denied for function pb_job_foremen_set', s);
  j := pg_temp.fget(pm, job); s := pg_temp.fe(j) || '/' || (j->>'may_remove') || '/' || pg_temp.fe(pg_temp.fget(mgr, job)) || '/' || (pg_temp.fget(mgr, job)->>'may_remove');
  insert into t_chk (name, ok, got) values ('2d a super (PM) and a listed manager read it; the super may take others off, the manager only themselves', s = 'ok/true/ok/false', s);

  -- ---- change it ----
  j := pg_temp.fset(o, job, array[f1, f2], 0);
  select string_agg(u::text, ',' order by u::text) into srt from unnest(array[f1, f2]) u;
  insert into t_chk (name, ok, got) values ('3a company account assigns two foremen: saved, list comes back with names and since, version 2',
    pg_temp.fe(j) = 'ok' and pg_temp.fids(j) = srt and (j->>'ver')::int = 2 and (select count(*) from jsonb_array_elements(j->'assigned') e where e->>'since' is not null and (e->>'current')::boolean) = 2, left(j::text, 300));
  j := pg_temp.fset(o, job, array[f1], 0);
  insert into t_chk (name, ok, got) values ('3b a save made on an old copy (version 0) is refused with pb:changed, nothing written, the list as it is now comes back',
    pg_temp.fe(j) = 'pb:changed' and pg_temp.fids(j) = srt and (j->>'ver')::int = 2
    and (select count(*) from pb_pm.job_foremen a where a.company_id = c and a.job_key = lower(job) and a.ended_at is null) = 2, left(j::text, 200));
  s := pg_temp.fe(pg_temp.fset(o, job, array[f1, p1], 2)) || '/' || pg_temp.fe(pg_temp.fset(o, job, array[f1, pm], 2)) || '/' || pg_temp.fe(pg_temp.fset(o, job, array[f1, x], 2));
  insert into t_chk (name, ok, got) values ('3c only a foreman of this company can be picked: a pipelayer, a super, another company''s foreman are refused (pb:not_foreman)', s = 'pb:not_foreman/pb:not_foreman/pb:not_foreman', s);
  select count(*) into n from pb_pm.audit a where a.company_id = c and a.action = 'job_foremen' and a.outcome = 'refused' and a.code = 'pb:not_foreman';
  insert into t_chk (name, ok, got) values ('3d each refusal is in the audit trail (3 rows), and the list did not change',
    n = 3 and (select count(*) from pb_pm.job_foremen a where a.company_id = c and a.job_key = lower(job) and a.ended_at is null) = 2, n::text);
  j := pg_temp.fset(pm, job, array[f1], 2);
  insert into t_chk (name, ok, got) values ('3e the super takes a foreman off (f2): saved, version 3, f2''s row ended "unassigned" by the super',
    pg_temp.fe(j) = 'ok' and pg_temp.fids(j) = f1::text and (j->>'ver')::int = 3
    and exists (select 1 from pb_pm.job_foremen a where a.user_id = f2 and a.job_key = lower(job) and a.end_reason = 'unassigned' and a.ended_by = pm), left(j::text, 200));
  j := pg_temp.fset(mgr, job, array[f1, f3], 3); v := (j->>'ver')::int;
  s := pg_temp.fe(j) || '/' || pg_temp.fe(pg_temp.fset(mgr, job, array[f3], v));
  insert into t_chk (name, ok, got) values ('3f a listed manager (not a PM) adds a foreman, but cannot take another one off (pb:owner_only, audited)',
    s = 'ok/pb:owner_only' and exists (select 1 from pb_pm.audit a where a.company_id = c and a.actor = mgr and a.code = 'pb:owner_only'), s);
  j := pg_temp.fset(mgr, job, array[f1, f3, mgr], v); v := (j->>'ver')::int;
  s := pg_temp.fe(j) || '/' || pg_temp.fe(pg_temp.fset(mgr, job, array[f1, f3], v));
  insert into t_chk (name, ok, got) values ('3g the manager (a foreman too) puts himself on and takes himself off', s = 'ok/ok', s);
  v := (pg_temp.fget(o, job)->>'ver')::int;
  s := pg_temp.fe(pg_temp.fq(o, format('select public.pb_job_foremen_set(%L, %L::uuid[], %L, %s)', job, array[f1], pm, v)))
    || '/' || pg_temp.fe(pg_temp.fq(o, format('select public.pb_job_foremen_set(%L, %L::uuid[], %L, null)', job, array[f1], o)));
  select array_agg(gen_random_uuid()) into many from generate_series(1, 21);
  s := s || '/' || pg_temp.fe(pg_temp.fset(o, job, many, v)) || '/' || pg_temp.fe(pg_temp.fset(f1, job, array[f1], v));
  insert into t_chk (name, ok, got) values ('3h refused: someone else''s account on the phone (pb:wrong_account), no version (pb:bad_version), more than 20 (pb:too_many_foremen), a plain foreman (pb:not_company_account)',
    s = 'pb:wrong_account/pb:bad_version/pb:too_many_foremen/pb:not_company_account', s);
  j := pg_temp.fset(o, ' ' || upper(job) || ' ', array[f1, f3, f1, null], v);
  select string_agg(u::text, ',' order by u::text) into srt from unnest(array[f1, f3]) u;
  insert into t_chk (name, ok, got) values ('3i the job number is matched like everywhere else (spaces, capitals), duplicates and blanks in the list are dropped; saving the same list keeps the rows',
    pg_temp.fe(j) = 'ok' and pg_temp.fids(j) = srt and (j->>'ver')::int = v and pg_temp.fids(pg_temp.fget(o, lower(job))) = srt, left(j::text, 200));
  j := pg_temp.fget(o2, job);
  insert into t_chk (name, ok, got) values ('3j another company''s account sees its own (empty) list for the same job number, never this one', pg_temp.fe(j) = 'ok' and jsonb_array_length(j->'assigned') = 0, left(j::text, 200));
  select count(*) into n from pb_pm.audit a where a.company_id = c and a.action = 'job_foremen' and a.outcome = 'ok';
  insert into t_chk (name, ok, got) values ('3k every save is in the audit trail (6 ok rows)', n = 6, n::text);

  -- ---- people change: the list follows ----
  update public.company_members set role = 'pipelayer' where user_id = f1;
  j := pg_temp.fget(o, job);
  insert into t_chk (name, ok, got) values ('4a a foreman made a pipelayer comes off every job (ended "not_foreman") and leaves the pick list',
    pg_temp.fids(j) = f3::text and exists (select 1 from pb_pm.job_foremen a where a.user_id = f1 and a.end_reason = 'not_foreman')
    and not exists (select 1 from jsonb_array_elements(j->'candidates') e where e->>'user_id' = f1::text), left(j::text, 200));
  delete from public.company_members where user_id = f3;
  j := pg_temp.fget(o, job);
  insert into t_chk (name, ok, got) values ('4b a foreman removed from the company comes off (ended "left_company")',
    jsonb_array_length(j->'assigned') = 0 and exists (select 1 from pb_pm.job_foremen a where a.user_id = f3 and a.end_reason = 'left_company'), left(j::text, 200));
  begin delete from pb_pm.job_foremen where company_id = c; s := 'deleted'; exception when others then s := sqlerrm; end;
  insert into t_chk (name, ok, got) values ('4c assignment history cannot be deleted (pb:pm_history_is_permanent)', s = 'pb:pm_history_is_permanent', s);

  -- ---- the PM/super assignment is untouched ----
  j := pg_temp.fq(o, format('select public.pb_job_pms_get(%L)', job));
  v := (j->>'ver')::int;
  s := pg_temp.fe(j) || '/' || pg_temp.fe(pg_temp.fq(o, format('select public.pb_job_pms_set(%L, %L::uuid[], %L, %s)', job, array[pm], o, v)));
  insert into t_chk (name, ok, got) values ('5a PMs & supers still read and save as before on the same job (no foremen in their list)',
    s = 'ok/ok' and not exists (select 1 from jsonb_array_elements(pg_temp.fq(o, format('select public.pb_job_pms_get(%L)', job))->'assigned') e where e->>'user_id' in (f1::text, f3::text)), s);

  select count(*) filter (where ok), count(*) filter (where ok is not true), coalesce(string_agg(name || ' [got: ' || coalesce(got, 'null') || ']', ' ; ' order by i) filter (where ok is not true), '') into pass, fail, fails from t_chk;
  notes := ' [app calls ran as role authenticated]';
  raise exception 'RESULT: % pass, % fail% %', pass, fail, case when fail > 0 then ' | FAILED: ' || fails else '' end, notes;
end $test$;
